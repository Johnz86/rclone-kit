*.py[cod]
*$py.class

# Build / packaging
build/
dist/
*.egg-info/
*.egg
MANIFEST

# Defensive: scripts/build_distribution.py stages the native library into an
# isolated temporary copy of the tree, so nothing should ever land here.
/src/rclone_kit/assets/native/

# Unpinned research checkout of upstream rclone/rclone - never a build
# input. The production source is the native/rclone submodule.
/reference/rclone/

